# Built from the REPO ROOT context (see docker-compose frontend.build.context: .)
# because the frontend is a yarn-workspace member — it needs the root
# package.json + yarn.lock + the `shared` workspace to install.
FROM node:22-alpine

WORKDIR /repo
RUN corepack enable

# Manifests first for a cached install layer. The root .yarnrc.yml pins the
# node-modules linker so the compose node_modules volumes work.
COPY .yarnrc.yml package.json yarn.lock ./
COPY frontend/package.json ./frontend/
COPY shared/package.json ./shared/
RUN yarn install --immutable

# Source (overlaid by bind mounts at runtime for HMR)
COPY frontend ./frontend
COPY shared ./shared

WORKDIR /repo/frontend
EXPOSE 5173
CMD ["yarn", "dev", "--host", "0.0.0.0"]
